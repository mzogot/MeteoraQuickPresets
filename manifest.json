{
  "manifest_version": 3,
  "name": "Meteora Quick Presets",
  "description": "One-click presets that fill Meteora's DLMM Create Position panel. Never submits a transaction.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://app.meteora.ag/*",
        "https://www.meteora.ag/*",
        "https://meteora.ag/*",
        "https://edge.meteora.ag/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
